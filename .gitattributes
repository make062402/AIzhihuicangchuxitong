# ============================================
# 换行符规范（跨平台协作关键）
# ============================================

# 默认：文本文件自动规范化换行符
* text=auto

# Shell 脚本必须保持 LF —— deploy/ 下的脚本要在 Linux 服务器上运行
# 若被 Windows checkout 成 CRLF 会导致脚本执行报错
*.sh text eol=lf

# 常见文本类型统一 LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.html text eol=lf

# 二进制文件不做转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.db binary
